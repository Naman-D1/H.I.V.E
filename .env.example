# Copy this file to ".env" and change the values.
PORT=3000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Where the SQLite database file lives
DB_FILE=hive.db

# Only emails ending in this domain can register (leave empty to allow any email while developing)
# Example: ALLOWED_EMAIL_DOMAIN=yourcollege.edu
ALLOWED_EMAIL_DOMAIN=

# An admin account is created automatically on first start if both are set
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=change-this-password
