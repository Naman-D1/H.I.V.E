# Copy this file to ".env" and change the values.
PORT=3000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=211b0141ec1cad386b4cfe16a207b6379daee9fa6097c4f020b8c26c143855e4b3c461deee3a49036c7a038e1648b9e6

# Where the SQLite database file lives
DB_FILE=hive.db

# Only emails ending in this domain can register (leave empty to allow any email while developing)
# Example: ALLOWED_EMAIL_DOMAIN=yourcollege.edu
ALLOWED_EMAIL_DOMAIN=

# An admin account is created automatically on first start if both are set
ADMIN_EMAIL=admin@mit.edu
ADMIN_PASSWORD=admin123
